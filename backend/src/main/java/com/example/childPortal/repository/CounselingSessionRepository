package com.example.childPortal.repository;

import com.example.childPortal.model.CounselingSession;
import org.springframework.data.mongodb.repository.MongoRepository;
import java.time.LocalDate;
import java.util.List;

public interface CounselingSessionRepository extends MongoRepository<CounselingSession, String> {
    List<CounselingSession> findByScheduledById(String socialWorkerId);
    List<CounselingSession> findByCaseId(String caseId);
    List<CounselingSession> findByStatus(String status);
    List<CounselingSession> findBySessionDate(LocalDate sessionDate);
    List<CounselingSession> findBySessionDateBetween(LocalDate start, LocalDate end);
    List<CounselingSession> findBySessionDateAndStatus(LocalDate sessionDate, String status);
}
